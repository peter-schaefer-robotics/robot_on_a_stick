---
/**
 * Einbettung der MPC-Pendel-Demo in eine Astro-Seite.
 *
 * Voraussetzung: Der Inhalt des Demo-Repos liegt unter `public/pendulum/`
 * (also `public/pendulum/index.html`, `public/pendulum/styles.css`,
 * `public/pendulum/js/...`). Alles unter `public/` wird von Astro unveraendert
 * ausgeliefert - es findet keine Buendelung statt, was hier genau richtig ist.
 *
 * Verwendung:
 *   ---
 *   import InvertedPendulumMpc from '../components/InvertedPendulumMpc.astro';
 *   ---
 *   <InvertedPendulumMpc lang="de" embed={true} height="820px" />
 */
export interface Props {
  /** Sprache der Oberflaeche. */
  lang?: 'de' | 'en';
  /** Farbschema. Ohne Angabe entscheidet die Demo selbst (System / gespeichert). */
  theme?: 'dark' | 'light';
  /** true blendet Kopfzeile, Erklaerungstexte und Fusszeile aus. */
  embed?: boolean;
  /** Hoehe des Rahmens, z. B. "820px" oder "80vh". */
  height?: string;
  /** Pfad unterhalb von public/, falls abweichend abgelegt. */
  path?: string;
  /** Titel des iframes (Barrierefreiheit). */
  title?: string;
}

const {
  lang = 'de',
  theme,
  embed = true,
  height = '820px',
  path = 'pendulum/',
  title = 'Inverses Pendel mit MPC-Regelung',
} = Astro.props;

// BASE_URL beachten, damit der Pfad auch bei einem gesetzten `base`
// (typisch fuer GitHub Pages unter /reponame/) stimmt.
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';

const params = new URLSearchParams({ lang });
if (theme) params.set('theme', theme);
if (embed) params.set('embed', '1');

const src = `${base}${path}index.html?${params.toString()}`;
---

<div class="ipm-embed" style={`--ipm-height: ${height}`}>
  <iframe
    src={src}
    title={title}
    loading="lazy"
    allowfullscreen
  ></iframe>
</div>

<style>
  .ipm-embed {
    width: 100%;
    height: var(--ipm-height, 820px);
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgba(128, 128, 128, 0.25);
  }
  .ipm-embed iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
  /* Auf kleinen Displays braucht die Demo mehr Hoehe, weil das Bedienfeld
     unter die Animation rutscht. */
  @media (max-width: 700px) {
    .ipm-embed { height: calc(var(--ipm-height, 820px) + 260px); }
  }
</style>
