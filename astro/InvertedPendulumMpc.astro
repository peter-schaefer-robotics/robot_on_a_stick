---
/**
 * Embeds the MPC pendulum playground in an Astro page.
 *
 * Prerequisite: the contents of the demo repo live under `public/pendulum/`
 * (that is, `public/pendulum/index.html`, `public/pendulum/styles.css`,
 * `public/pendulum/js/...`). Anything under `public/` is served verbatim by
 * Astro with no bundling, which is exactly what is wanted here.
 *
 * Usage:
 *   ---
 *   import InvertedPendulumMpc from '../components/InvertedPendulumMpc.astro';
 *   ---
 *   <InvertedPendulumMpc mode="simple" embed={true} height="900px" />
 */
export interface Props {
  /** Mode the demo starts in. */
  mode?: 'simple' | 'expert';
  /** Colour scheme. Without it the demo decides for itself (system / stored). */
  theme?: 'dark' | 'light';
  /** true hides the heading, the explanations and the footer. */
  embed?: boolean;
  /** Height of the frame, e.g. "900px" or "85vh". */
  height?: string;
  /** Path below public/, if you put the files somewhere else. */
  path?: string;
  /** Title of the iframe (accessibility). */
  title?: string;
}

const {
  mode = 'simple',
  theme,
  embed = true,
  height = '900px',
  path = 'pendulum/',
  title = 'Inverted pendulum with MPC control',
} = Astro.props;

// Respect BASE_URL so the path also works with a `base` set in
// astro.config.mjs — typical for GitHub Pages serving from /reponame/.
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';

const params = new URLSearchParams({ mode });
if (theme) params.set('theme', theme);
if (embed) params.set('embed', '1');

const src = `${base}${path}index.html?${params.toString()}`;
---

<div class="ipm-embed" style={`--ipm-height: ${height}`}>
  <iframe
    src={src}
    title={title}
    loading="lazy"
    allowfullscreen
  ></iframe>
</div>

<style>
  .ipm-embed {
    width: 100%;
    height: var(--ipm-height, 900px);
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgba(128, 128, 128, 0.25);
  }
  .ipm-embed iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
  /* On narrow screens the demo needs more height, because the controls move
     below the animation and the formula wraps onto several lines. */
  @media (max-width: 700px) {
    .ipm-embed { height: calc(var(--ipm-height, 900px) + 300px); }
  }
</style>
